# =============================================================================
# Environment Variables for KG Project
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# Flask Configuration
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=9000
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# Database Connections (values from docker-compose.yaml)
# =============================================================================

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=root
NEO4J_DATABASE=neo4j

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kg_users
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_SSLMODE=disable

# MongoDB Configuration
MONGODB_URI=mongodb://root:root@mongo:27017/
MONGODB_DATABASE=kg_chat_history
MONGODB_USERNAME=root
MONGODB_PASSWORD=root

# =============================================================================
# External Services (fill these in yourself)
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# SMTP Configuration (Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password

# OTP Configuration
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
